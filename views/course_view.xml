<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- list view -->
    <record id="view_course_list" model="ir.ui.view">
        <field name="name">course.model.list</field>
        <field name="model">course.model</field>
        <field name="arch" type="xml">
            <tree string="Courses">
                <field name="title"/>
                <field name="description"/>
            </tree>
        </field>
    </record>

    <!-- form view -->
     <record id="view_course_form" model="ir.ui.view">
        <field name="name">course.model.form</field>
        <field name="model">course.model</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="title"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <!-- search view -->
    <record id="view_course_search" model="ir.ui.view">
        <field name="name">course.model.search</field>
        <field name="model">course.model</field>
        <field name="arch" type="xml">
            <search>
                <field name="title"/>
                <field name="description"/>

<!--                <filter name="group_by_course_id" string="COURSE ID"-->
<!--                            context="{'group_by': 'course_id'}"/>-->

            </search>
        </field>
    </record>
</odoo>